# ARIS — Advanced Research Intelligence System Environment Variables

# AI Engine Configuration
# GEMINI_API_KEY: Required for server-side Gemini 3.8 Flash model calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Server Host and Port
PORT=3000
NODE_ENV="development"

# App Deployment URL
APP_URL="http://localhost:3000"

# Vector Search (Optional Hosted Qdrant instance for hybrid scale)
# QDRANT_URL="https://your-cluster-id.qdrant.io:6333"
# QDRANT_API_KEY="your-qdrant-api-key"

# Database Configuration (Optional Supabase Postgres connection)
# SUPABASE_URL="https://your-project.supabase.co"
# SUPABASE_ANON_KEY="your-anon-key"

# Academic API Contact Emails (Polite pool access for OpenAlex & Crossref)
# OPENALEX_EMAIL="researcher@university.edu"
# CROSSREF_EMAIL="researcher@university.edu"
